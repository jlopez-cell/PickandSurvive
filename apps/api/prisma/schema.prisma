// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPERADMIN
}

enum ChampionshipMode {
  TOURNAMENT
  LEAGUE
  WORLD_CUP
}

enum TournamentPhase {
  GROUP_STAGE
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINALS
  SEMI_FINALS
  THIRD_PLACE
  FINAL
}

enum EditionStatus {
  DRAFT
  OPEN
  ACTIVE
  FINISHED
  CANCELLED
}

enum ParticipantStatus {
  ACTIVE
  ELIMINATED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JoinRequestSource {
  LINK
  EMAIL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum MatchdayStatus {
  SCHEDULED
  ONGOING
  FINISHED
}

enum PickStatus {
  PENDING
  SURVIVED
  DRAW_ELIMINATED
  LOSS_ELIMINATED
  NO_PICK_ELIMINATED
  POSTPONED_PENDING
}

enum PotLedgerType {
  ENTRY_FEE
  PRIZE_PAYOUT
  ACCUMULATED_IN
  ACCUMULATED_OUT
}

enum NotificationType {
  INVITATION
  JOIN_APPROVED
  JOIN_REJECTED
  PICK_REMINDER
  EDITION_FINISHED
  NEW_JOIN_REQUEST
}

enum PickHalf {
  FIRST
  SECOND
}

enum PickType {
  WIN
  WIN_OR_DRAW
}

enum ChallengeStatus {
  ACTIVE
  RESOLVED
}

enum ChallengeResult {
  CHALLENGER_WINS
  CHALLENGED_WINS
  TIE
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  alias          String    @unique
  emailVerified              Boolean   @default(false)
  role                       UserRole  @default(USER)
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  championshipsCreated Championship[]  @relation("Creator")
  championshipsAdmined Championship[]  @relation("Admin")
  participants         Participant[]
  joinRequests         JoinRequest[]
  notifications        Notification[]
  notificationPrefs    UserNotificationPrefs?
  potLedgerEntries     PotLedger[]
  wonEditions          Edition[]      @relation("EditionWinner")
}

model Championship {
  id                     String           @id @default(uuid())
  name                   String
  creatorId              String
  adminId                String
  footballLeagueId       String
  mode                   ChampionshipMode
  pickResetAtMidseason   Boolean          @default(false)
  streakBonusEnabled     Boolean          @default(false)
  wildcardCount          Int              @default(0)
  ghostModeEnabled       Boolean          @default(false)
  socialPressureEnabled  Boolean          @default(false)
  doubleOrNothingEnabled Boolean          @default(false)
  underdogBonusEnabled   Boolean          @default(false)
  blockCount             Int              @default(0)
  vetoCount              Int              @default(0)
  challengeCount         Int              @default(0)
  createdAt              DateTime         @default(now())

  creator        User           @relation("Creator", fields: [creatorId], references: [id])
  admin          User           @relation("Admin", fields: [adminId], references: [id])
  footballLeague FootballLeague @relation(fields: [footballLeagueId], references: [id])
  editions       Edition[]
  joinRequests   JoinRequest[]
  invitationLinks InvitationLink[]
}

model Edition {
  id                  String        @id @default(uuid())
  championshipId      String
  startMatchday       Int
  endMatchday         Int?
  potAmountCents      Int           @default(0)
  accumulatedPotCents Int           @default(0)
  status              EditionStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  finishedAt          DateTime?
  name                String?
  winnerUserId        String?

  championship Championship  @relation(fields: [championshipId], references: [id])
  participants Participant[]
  potLedger    PotLedger[]
  winner       User?         @relation("EditionWinner", fields: [winnerUserId], references: [id])
  blocks       Block[]
  vetos        Veto[]
  challenges   Challenge[]
}

model Participant {
  id                   String            @id @default(uuid())
  userId               String
  editionId            String
  status               ParticipantStatus @default(ACTIVE)
  eliminatedAtMatchday Int?
  eliminatedAtPhase    TournamentPhase?
  totalPoints          Int               @default(0)
  wildcardsRemaining   Int               @default(0)
  isGhost              Boolean           @default(false)
  joinedAt             DateTime          @default(now())
  blocksRemaining      Int               @default(0)
  vetosRemaining       Int               @default(0)
  challengesRemaining  Int               @default(0)

  user      User        @relation(fields: [userId], references: [id])
  edition   Edition     @relation(fields: [editionId], references: [id])
  picks     Pick[]
  teamUsages TeamUsage[]

  blocksGiven        Block[]     @relation("BlocksGiven")
  blocksReceived     Block[]     @relation("BlocksReceived")
  vetoesGiven        Veto[]      @relation("VetoesGiven")
  vetoesReceived     Veto[]      @relation("VetoesReceived")
  challengesGiven    Challenge[] @relation("ChallengesGiven")
  challengesReceived Challenge[] @relation("ChallengesReceived")

  @@unique([userId, editionId])
  @@index([editionId, totalPoints])
  @@index([editionId, eliminatedAtMatchday])
}

model JoinRequest {
  id             String            @id @default(uuid())
  championshipId String
  userId         String
  status         JoinRequestStatus @default(PENDING)
  source         JoinRequestSource
  createdAt      DateTime          @default(now())

  championship Championship @relation(fields: [championshipId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([championshipId, userId])
}

model InvitationLink {
  id             String   @id @default(uuid())
  championshipId String
  token          String   @unique @default(uuid())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  championship Championship @relation(fields: [championshipId], references: [id])
}

model FootballLeague {
  id                      String  @id @default(uuid())
  name                    String
  country                 String
  apiFootballId           Int     @unique
  totalMatchdaysPerSeason Int
  currentSeason           Int

  teams         FootballTeam[]
  matchdays     Matchday[]
  championships Championship[]
  wcGroups      WcGroup[]
}

model FootballTeam {
  id            String @id @default(uuid())
  leagueId      String
  name          String
  logoUrl       String
  apiFootballId Int    @unique

  league          FootballLeague   @relation(fields: [leagueId], references: [id])
  homeMatches     Match[]          @relation("HomeTeam")
  awayMatches     Match[]          @relation("AwayTeam")
  wonMatches      Match[]          @relation("WinnerTeam")
  picks           Pick[]
  teamUsages      TeamUsage[]
  wcGroupStandings WcGroupStanding[]
  vetos           Veto[]
}

model Matchday {
  id               String          @id @default(uuid())
  leagueId         String
  season           Int
  number           Int
  status           MatchdayStatus  @default(SCHEDULED)
  firstKickoff     DateTime?
  tournamentPhase  TournamentPhase?
  wcGroupDay       Int?

  league   FootballLeague @relation(fields: [leagueId], references: [id])
  matches  Match[]
  picks    Pick[]

  @@unique([leagueId, season, number])
}

model Match {
  id                   String           @id @default(uuid())
  matchdayId           String
  homeTeamId           String
  awayTeamId           String
  winnerTeamId         String?
  kickoffTime          DateTime
  homeScore            Int?
  awayScore            Int?
  status               MatchStatus      @default(SCHEDULED)
  apiFootballFixtureId Int              @unique
  tournamentPhase      TournamentPhase?
  wcGroup              String?

  matchday   Matchday      @relation(fields: [matchdayId], references: [id])
  homeTeam   FootballTeam  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   FootballTeam  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winnerTeam FootballTeam? @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
}

model Pick {
  id                String     @id @default(uuid())
  participantId     String
  matchdayId        String
  /// Ausente cuando status es NO_PICK_ELIMINATED (no se asigna equipo ficticio).
  teamId            String?
  status            PickStatus @default(PENDING)
  pickType          PickType   @default(WIN)
  pointsAwarded     Int?
  isDoubleOrNothing Boolean    @default(false)
  streakBonusPoints Int        @default(0)
  underdogBonus     Boolean    @default(false)
  createdAt         DateTime   @default(now())

  participant Participant   @relation(fields: [participantId], references: [id])
  matchday    Matchday      @relation(fields: [matchdayId], references: [id])
  team        FootballTeam? @relation(fields: [teamId], references: [id])

  @@unique([participantId, matchdayId])
  @@index([matchdayId, status])
}

model TeamUsage {
  id            String   @id @default(uuid())
  participantId String
  teamId        String
  editionId     String
  half          PickHalf @default(FIRST)

  participant Participant  @relation(fields: [participantId], references: [id])
  team        FootballTeam @relation(fields: [teamId], references: [id])

  @@unique([participantId, teamId, editionId, half])
  @@index([participantId, editionId])
}

model WcGroup {
  id       String @id @default(uuid())
  leagueId String
  season   Int
  name     String

  league    FootballLeague   @relation(fields: [leagueId], references: [id])
  standings WcGroupStanding[]

  @@unique([leagueId, season, name])
}

model WcGroupStanding {
  id           String @id @default(uuid())
  groupId      String
  teamId       String
  position     Int
  played       Int    @default(0)
  won          Int    @default(0)
  drawn        Int    @default(0)
  lost         Int    @default(0)
  goalsFor     Int    @default(0)
  goalsAgainst Int    @default(0)
  points       Int    @default(0)

  group WcGroup      @relation(fields: [groupId], references: [id])
  team  FootballTeam @relation(fields: [teamId], references: [id])

  @@unique([groupId, teamId])
  @@index([groupId, points])
}

model PotLedger {
  id          String        @id @default(uuid())
  editionId   String
  userId      String?
  type        PotLedgerType
  amountCents Int
  description String
  createdAt   DateTime      @default(now())

  edition Edition @relation(fields: [editionId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([editionId])
  @@index([type])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  dismissed Boolean          @default(false)
  sentEmail Boolean          @default(false)
  sentPush  Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

model UserNotificationPrefs {
  id                   String  @id @default(uuid())
  userId               String  @unique
  emailEnabled         Boolean @default(true)
  pushEnabled          Boolean @default(false)
  pushSubscriptionJson String?

  user User @relation(fields: [userId], references: [id])
}

model Block {
  id                   String      @id @default(cuid())
  editionId            String
  blockerParticipantId String
  blockedParticipantId String
  matchdayNumber       Int
  createdAt            DateTime    @default(now())

  edition  Edition     @relation(fields: [editionId], references: [id])
  blocker  Participant @relation("BlocksGiven", fields: [blockerParticipantId], references: [id])
  blocked  Participant @relation("BlocksReceived", fields: [blockedParticipantId], references: [id])

  @@unique([editionId, blockedParticipantId, matchdayNumber])
}

model Veto {
  id                  String       @id @default(cuid())
  editionId           String
  vetoerParticipantId String
  vetoedParticipantId String
  teamId              String
  matchdayNumber      Int
  createdAt           DateTime     @default(now())

  edition Edition      @relation(fields: [editionId], references: [id])
  vetoer  Participant  @relation("VetoesGiven", fields: [vetoerParticipantId], references: [id])
  vetoed  Participant  @relation("VetoesReceived", fields: [vetoedParticipantId], references: [id])
  team    FootballTeam @relation(fields: [teamId], references: [id])

  @@unique([editionId, vetoedParticipantId, teamId, matchdayNumber])
}

model Challenge {
  id                      String          @id @default(cuid())
  editionId               String
  challengerParticipantId String
  challengedParticipantId String
  matchdayNumber          Int
  status                  ChallengeStatus @default(ACTIVE)
  result                  ChallengeResult?
  createdAt               DateTime        @default(now())
  resolvedAt              DateTime?

  edition    Edition     @relation(fields: [editionId], references: [id])
  challenger Participant @relation("ChallengesGiven", fields: [challengerParticipantId], references: [id])
  challenged Participant @relation("ChallengesReceived", fields: [challengedParticipantId], references: [id])

  @@unique([editionId, challengerParticipantId, matchdayNumber])
}
